# ── Copy this file to .env and fill in your keys ──────────────────────────

# NewsAPI key (https://newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# FinBERT API (optional — enables per-headline sentiment scoring)
# Leave blank to fall back to Neutral for all headlines
FINBERT_API_URL=
FINBERT_API_KEY=

# Google Sheets REST API for company search directory (optional)
GOOGLE_SHEETS_URL=

# Flask runtime settings
PORT=5000
FLASK_DEBUG=true
